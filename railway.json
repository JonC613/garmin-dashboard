version: 2
services:
  - type: web
    name: garmin-dashboard-backend
    runtime: python
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn api:app --host 0.0.0.0 --port $PORT
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: garmin-postgres
          property: connectionString
      - key: GARMIN_EMAIL
        sync: false
      - key: GARMIN_PASSWORD
        sync: false
    autoDeploy: true

databases:
  - name: garmin-postgres
    plan: starter
    databaseName: garmin_dashboard
